{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caroffers.local/schemas/knowledge-v2.schema.json",
  "title": "CarOffers model engine knowledge v2",
  "type": "object",
  "required": ["version", "modelKey", "engineClaims", "sources"],
  "properties": {
    "version": { "const": 2, "type": "integer" },
    "modelKey": { "type": "string", "minLength": 1 },
    "engineClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "scope", "confidence", "sourceIds", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": {},
          "scope": { "type": "object" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "publishedAt", "checkedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "publishedAt": { "type": ["string", "null"] },
          "checkedAt": { "type": "string", "format": "date" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
